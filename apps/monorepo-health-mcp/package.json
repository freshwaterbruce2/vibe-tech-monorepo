{
  "name": "monorepo-health-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for monorepo health, database health, workspace paths, and system maintenance",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "dotenv": "^16.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "catalog:"
  }
}
