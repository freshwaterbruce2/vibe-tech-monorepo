{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/proposal-review-saas/Dockerfile",
    "watchPatterns": [
      "apps/proposal-review-saas/**",
      "packages/auth/**",
      "packages/analytics/**",
      "packages/billing/**",
      "packages/emails/**",
      "packages/entitlements/**",
      "packages/feature-flags/core/**",
      "packages/landing/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
