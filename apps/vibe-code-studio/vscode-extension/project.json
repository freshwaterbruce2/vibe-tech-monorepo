{
  "name": "vibe-code-studio-vscode",
  "projectType": "library",
  "tags": [
    "scope:vibe-code-studio",
    "type:extension",
    "platform:vscode"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../../node_modules/typescript/bin/tsc --noEmit",
        "cwd": "apps/vibe-code-studio/vscode-extension"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../../node_modules/typescript/bin/tsc",
        "cwd": "apps/vibe-code-studio/vscode-extension"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../../node_modules/typescript/bin/tsc --noEmit",
        "cwd": "apps/vibe-code-studio/vscode-extension"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Lint not configured for VS Code extension'",
        "cwd": "apps/vibe-code-studio/vscode-extension"
      }
    }
  }
}
