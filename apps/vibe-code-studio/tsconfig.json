{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@services/*": ["./src/services/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@electron/*": ["./electron/*"],
      "@vibetech/types": ["../../packages/types/src/index.ts"],
      "@vibetech/types/*": ["../../packages/types/src/*"],
      "@vibetech/auth": ["../../packages/auth/src/index.ts"],
      "@vibetech/billing": ["../../packages/billing/src/index.ts"],
      "@vibetech/entitlements": ["../../packages/entitlements/src/index.ts"],
      "@vibetech/landing": ["../../packages/landing/src/index.tsx"],
      "@vibetech/feature-flags-core": ["../../packages/feature-flags/core/src/index.ts"],
      "@vibetech/feature-flags-sdk-node": ["../../packages/feature-flags/sdk-node/src/index.ts"],
      "@vibetech/shared-ipc": ["../../packages/shared-ipc/src/index.ts"],
      "@vibetech/core": ["../../packages/core/src/index.ts"],
      "@vibetech/core/*": ["../../packages/core/src/*"],
      "@vibetech/*": ["../../packages/*/src"],
      "@dev/feature-flags-*": ["../../packages/feature-flags/*/src"]
    },
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*",
    "src/**/*.tsx",
    "src/**/*.ts",
    "src/vite-env.d.ts",
    "electron/**/*",
    "electron/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "dist/**/*",
    "build/**/*",
    "src/__tests__/**/*"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "references": [
    {
      "path": "../../packages/shared-ipc"
    },
    {
      "path": "../../packages/entitlements"
    },
    {
      "path": "../../packages/billing"
    },
    {
      "path": "../../packages/auth"
    }
  ]
}
