{
  "identifier": "main-capability",
  "description": "Vibe Code Studio main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": true },
        { "name": "exec-cmd", "cmd": "powershell", "args": true },
        { "name": "ssh", "cmd": "ssh", "args": true },
        { "name": "vcs-backend", "sidecar": true, "args": true }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "V:\\**" },
        { "path": "D:\\databases\\vibe_studio.db" },
        { "path": "D:\\logs\\vibe-code-studio\\**" },
        { "path": "D:\\data\\vibe-code-studio\\**" },
        { "path": "D:\\learning-system\\**" }
      ]
    }
  ]
}
