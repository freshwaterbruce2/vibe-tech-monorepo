{
  "productName": "Vibe Code Studio",
  "version": "1.2.3",
  "identifier": "com.vibetech.vibe-code-studio",
  "build": {
    "beforeDevCommand": "pnpm exec vite --port 5174",
    "beforeBuildCommand": "node scripts/build-sidecar.cjs && pnpm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Vibe Code Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost tauri: http://127.0.0.1:3190 http://localhost:3190 http://127.0.0.1:5004 http://localhost:5004 http://localhost:3001 http://localhost:3100 ws://localhost:4444 ws://127.0.0.1:5004 ws://localhost:5004 https://api.github.com; worker-src 'self' blob:; media-src 'self' blob:; child-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/vcs-backend"],
    "resources": ["sidecar/**/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "wix": {
        "fragmentPaths": ["windows/explicit-install-dir.wxs"],
        "componentGroupRefs": ["ExplicitInstallDirSupportGroup"]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
