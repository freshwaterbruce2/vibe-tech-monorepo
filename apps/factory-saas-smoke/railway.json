{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd apps/factory-saas-smoke && pnpm run build:shared:api && pnpm run build:api",
    "watchPatterns": [
      "apps/factory-saas-smoke/**",
      "packages/auth/**",
      "packages/analytics/**",
      "packages/billing/**",
      "packages/emails/**",
      "packages/entitlements/**",
      "packages/landing/**"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/factory-saas-smoke && pnpm run start:api",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
