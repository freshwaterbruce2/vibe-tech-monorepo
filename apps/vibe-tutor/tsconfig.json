{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@testing-library/jest-dom"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "preserve",
    // Type Safety: Gradual strict mode enablement
    "strict": true,
    "strictNullChecks": true, // ✓ Enabled: Catch null/undefined bugs
    "strictFunctionTypes": true, // ✓ Enabled: Better function type checking
    "noImplicitThis": true, // ✓ Enabled: Require explicit 'this' typing
    "noUncheckedIndexedAccess": true, // ✓ Enabled: Array/object access safety
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vibetech/avatars": ["../../packages/avatars/src/index.ts"],
      "@vibetech/avatars/*": ["../../packages/avatars/src/*"],
      "@vibetech/games": ["../../packages/games/src/index.ts"],
      "@vibetech/games/tutor": ["../../packages/games/src/tutor/index.ts"],
      "@vibetech/games/*": ["../../packages/games/src/*/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "src/types/**/*", "electron/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "*.config.ts", "capacitor.config.ts"],
  "references": [
    {
      "path": "../../packages/openrouter-client"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
