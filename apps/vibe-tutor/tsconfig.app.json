{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vibetech/avatars": ["../../packages/avatars/src/index.ts"],
      "@vibetech/avatars/*": ["../../packages/avatars/src/*"],
      "@vibetech/games": ["../../packages/games/src/index.ts"],
      "@vibetech/games/tutor": ["../../packages/games/src/tutor/index.ts"],
      "@vibetech/games/*": ["../../packages/games/src/*/index.ts"]
    },
    "strict": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "android",
    "electron/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../packages/openrouter-client"
    }
  ]
}
