# Vibe Tutor backend-only environment example.
# OpenRouter owns server-side routing: DeepSeek primary and Gemini paid fallback.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Required production readiness inputs. Keep all values server-side.
SESSION_SIGNING_SECRET=REPLACE_WITH_SECRET
INSTALLATION_HMAC_SECRET=REPLACE_WITH_SECRET
PLAY_CERTIFICATE_SHA256=REPLACE_WITH_EXACT_PLAY_CERTIFICATE_DIGEST
VIBE_TUTOR_INTEGRITY_CLOUD_PROJECT_NUMBER=REPLACE_WITH_PROJECT_NUMBER
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT
FIRESTORE_DATABASE=(default)

# Local backend port.
PORT=3001
