# Vibe Tutor backend-only environment example.
# Do not put secrets in browser, Capacitor, or client configuration files.

# OpenRouter owns the server-side model routing: DeepSeek primary and Gemini paid fallback.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Required entitlement/session secrets (server-side only).
SESSION_SIGNING_SECRET=REPLACE_WITH_SECRET
INSTALLATION_HMAC_SECRET=REPLACE_WITH_SECRET
PLAY_CERTIFICATE_SHA256=REPLACE_WITH_EXACT_PLAY_CERTIFICATE_DIGEST
VIBE_TUTOR_INTEGRITY_CLOUD_PROJECT_NUMBER=REPLACE_WITH_PROJECT_NUMBER

# Production cloud adapters (server-side only).
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT
FIRESTORE_DATABASE=(default)

# Local backend port.
PORT=3001
NODE_ENV=production

# Never commit an actual .env file or expose any value above in client code, logs, or command arguments.
