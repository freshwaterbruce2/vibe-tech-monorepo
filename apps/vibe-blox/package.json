{
  "name": "@vibetech/vibe-blox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Token-based incentive system for developmental growth",
  "author": "Bruce (Dad)",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js",
    "build": "tsc && node ../../node_modules/vite/bin/vite.js build",
    "preview": "node ../../node_modules/vite/bin/vite.js preview",
    "server": "npx tsx server/index.ts",
    "server:prod": "cross-env NODE_ENV=production tsx server/index.ts",
    "db:migrate": "npx tsx server/db/index.ts",
    "db:seed": "npx tsx server/db/seed.ts",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "quality": "pnpm lint && pnpm typecheck && pnpm build",
    "package": "node package-app.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/zod-validator": "^0.7.6",
    "@radix-ui/react-accordion": "^1.2.12",
