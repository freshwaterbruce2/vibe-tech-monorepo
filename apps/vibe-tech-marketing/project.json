{
  "name": "vibe-tech-marketing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vibe-tech-marketing/src",
  "projectType": "application",
  "implicitDependencies": ["@vibetech/landing"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/vibe-tech-marketing"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/vibe-tech-marketing"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run preview",
        "cwd": "apps/vibe-tech-marketing"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "apps/vibe-tech-marketing"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/vibe-tech-marketing"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/eslint/bin/eslint.js src vite.config.ts --ext .ts,.tsx",
        "cwd": "apps/vibe-tech-marketing"
      }
    },
    "quality": {}
  },
  "tags": ["scope:web", "type:application", "factory:generated", "factory:landing-only"]
}
