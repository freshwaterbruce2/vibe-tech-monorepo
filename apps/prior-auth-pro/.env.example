# Fastify API bind address for local development.
PORT=5320
# Fastify host for local development.
HOST=127.0.0.1
# Frontend URL used by the browser app to reach the local API.
VITE_API_BASE_URL=http://127.0.0.1:5320
# Public app base URL used to build Stripe success and cancel redirects.
APP_BASE_URL=http://127.0.0.1:4320
# Shared auth secret for generated cookie sessions. Use at least 32 characters.
AUTH_SECRET=replace-with-a-long-local-auth-secret
# Starter generated login email for the operator account.
DEMO_USER_EMAIL=owner@example.com
# Starter generated login password. Replace before shipping.
DEMO_USER_PASSWORD=change-this-password
# Display name used for the starter operator account.
DEMO_USER_NAME=PriorAuthPro Owner
# Stripe test secret key from the Stripe dashboard: Developers -> API keys.
STRIPE_SECRET_KEY=
# Stripe publishable key for any future frontend billing UI.
STRIPE_PUBLISHABLE_KEY=
# Stripe publishable key exposed to the browser when billing UI is added.
VITE_STRIPE_PUBLIC_KEY=
# AI provider for appeal generation. Set one provider key in production.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
PRIOR_AUTH_AI_MODEL=
# Resend API key for welcome, receipt, password reset, and dunning emails.
RESEND_API_KEY=
# Sentry DSN for frontend and backend error reporting.
SENTRY_DSN=
