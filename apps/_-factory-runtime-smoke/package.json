{
  "name": "_-factory-runtime-smoke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4320",
    "build:shared:api": "cd /d ..\\..\\packages\\auth && pnpm build && cd /d ..\\entitlements && pnpm build && cd /d ..\\billing && pnpm build && cd /d ..\\emails && pnpm build && cd /d ..\\analytics && pnpm build && cd /d ..\\landing && pnpm build",
    "dev:api": "pnpm run build:shared:api && tsx watch server/src/index.ts",
    "build": "node ../../node_modules/vite/bin/vite.js build",
    "preview": "node ../../node_modules/vite/bin/vite.js preview",
    "build:api": "tsc -p server/tsconfig.json",
    "start:api": "node server/dist/index.js",
    "ship:check": "pnpm run build:shared:api && pnpm run build && pnpm run build:api && tsx server/scripts/ship-check.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibetech/auth": "workspace:*",
    "@vibetech/analytics": "workspace:*",
    "@vibetech/billing": "workspace:*",
    "@vibetech/emails": "workspace:*",
    "@vibetech/entitlements": "workspace:*",
    "@vibetech/landing": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "fastify": "^5.8.4",
    "@fastify/cors": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
