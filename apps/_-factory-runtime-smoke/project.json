{
  "name": "_-factory-runtime-smoke",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/_-factory-runtime-smoke/src",
  "projectType": "application",
  "implicitDependencies": [
    "@vibetech/auth",
    "@vibetech/analytics",
    "@vibetech/billing",
    "@vibetech/emails",
    "@vibetech/entitlements",
    "@vibetech/landing"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run preview",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "api:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev:api",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "api:build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/server/dist"],
      "options": {
        "command": "pnpm run build:api",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "api:start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run start:api",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "ship:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run ship:check",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/eslint/bin/eslint.js src server/src vite.config.ts --ext .ts,.tsx --ignore-pattern \"server/src/**/*.test.ts\"",
        "cwd": "apps/_-factory-runtime-smoke"
      }
    },
    "quality": {}
