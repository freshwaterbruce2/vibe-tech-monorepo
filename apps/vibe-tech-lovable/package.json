  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1 --port 8082",
    "build": "node ../../node_modules/vite/bin/vite.js build && pnpm run sync:spa-routes",
    "build:production": "node ../../node_modules/vite/bin/vite.js build --config vite.config.production.ts && pnpm run sync:spa-routes",
    "build:dev": "node ../../node_modules/vite/bin/vite.js build --mode development && pnpm run sync:spa-routes",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dev-dist --ignore-pattern backend --ignore-pattern tests --ignore-pattern '*.cjs'",
    "preview": "node ../../node_modules/vite/bin/vite.js preview",
    "analyze": "npm run build:production && npx vite-bundle-analyzer dist",
    "test": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage --passWithNoTests",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:debug": "playwright test --debug",
    "server:dev": "node backend/server.mjs",
    "typecheck": "tsc --noEmit",
    "sync:spa-routes": "node scripts/create-static-route-stubs.mjs"
