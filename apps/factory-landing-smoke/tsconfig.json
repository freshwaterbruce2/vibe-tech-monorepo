{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vibetech/*": ["../../packages/*/src", "../../packages/feature-flags/*/src"],
      "vite": ["../../node_modules/vite"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
