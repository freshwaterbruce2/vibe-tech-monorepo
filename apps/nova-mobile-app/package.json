{
  "name": "nova-mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "adb:reverse": "pwsh ./scripts/adb-reverse.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.ts src/**/*.integration.test.ts",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "android:build": "node scripts/run-gradle.cjs clean bundleRelease",
    "android:build:clean": "node scripts/run-gradle.cjs clean assembleDebug",
    "android:build:debug": "node scripts/run-gradle.cjs assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:uninstall": "adb uninstall com.nova.assistant || exit 0",
    "android:deploy": "pnpm run android:build:debug && pnpm run android:uninstall && pnpm run android:install"
  },
  "dependencies": {
    "@expo/vector-icons": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@react-native-community/netinfo": "catalog:",
    "@react-navigation/bottom-tabs": "catalog:",
    "@react-navigation/native": "catalog:",
    "@react-navigation/native-stack": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-device": "catalog:",
    "expo-haptics": "catalog:",
    "expo-local-authentication": "catalog:",
    "expo-notifications": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-speech": "catalog:",
    "expo-status-bar": "catalog:",
    "lucide-react-native": "catalog:",
    "memoize-one": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
