# Fastify API bind address for local development.
PORT=5320
# Fastify host for local development.
HOST=127.0.0.1
# Frontend URL used by the browser app to reach the local API.
VITE_API_BASE_URL=http://127.0.0.1:5320
# Public app base URL used to build Stripe success and cancel redirects.
APP_BASE_URL=http://127.0.0.1:4320
# Shared auth secret for generated cookie sessions. Use at least 32 characters.
AUTH_SECRET=replace-with-a-long-local-auth-secret
# Persistent SQLite database path. Defaults to D:\databases\discharge_ez.db.
DISCHARGE_EZ_DB_PATH=
# One-time bootstrap login email used only when the SQLite users table is empty.
DISCHARGE_EZ_BOOTSTRAP_EMAIL=owner@example.com
# One-time bootstrap login password used only when the SQLite users table is empty.
DISCHARGE_EZ_BOOTSTRAP_PASSWORD=change-this-password
# Display name for the first SQLite operator account.
DISCHARGE_EZ_BOOTSTRAP_NAME=DischargeEz Owner
# Optional Stripe recurring Price ID. If absent, Checkout creates a monthly $9 price_data item.
DISCHARGE_EZ_STRIPE_PRICE_ID=
# Fallback monthly amount in cents for inline Stripe subscription price_data.
DISCHARGE_EZ_PRO_MONTHLY_CENTS=900
# Stripe test secret key from the Stripe dashboard: Developers -> API keys.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret from Developers -> Webhooks.
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key for any future frontend billing UI.
VITE_STRIPE_PUBLIC_KEY=
# Resend API key for welcome, receipt, password reset, and dunning emails.
RESEND_API_KEY=
# Sentry DSN for frontend and backend error reporting.
SENTRY_DSN=
