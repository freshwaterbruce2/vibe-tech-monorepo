{
  "name": "learning-pipeline-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for orchestrating learning system insight-to-skill pipeline",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "catalog:"
  }
}
