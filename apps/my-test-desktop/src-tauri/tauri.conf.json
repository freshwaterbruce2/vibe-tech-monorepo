{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTestDesktop",
  "version": "0.1.0",
  "identifier": "com.vibetech.my-test-desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://127.0.0.1:4330",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyTestDesktop",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
