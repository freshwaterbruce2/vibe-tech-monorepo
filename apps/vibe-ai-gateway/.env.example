# Vibe AI Gateway Configuration

# Upstream OpenRouter API key (Master key with DeepSeek and Gemini access)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Comma-separated list of authorized client keys for individual Vibe Tech apps
VIBE_GATEWAY_CLIENT_KEYS=vibe_sk_invoiceflow_live_d82a17f,vibe_sk_avatarstudio_live_c4910e,vibe_sk_tutor_live_9f02b1

# Master gateway key for internal administrative access or microservice health
MASTER_GATEWAY_KEY=vibe_master_gateway_secret_key

# Port
PORT=8080
