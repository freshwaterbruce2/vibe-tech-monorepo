# Server Configuration
PORT=5005
NODE_ENV=development

# Storage Paths (Must be on D:\ drive per policy)
DATABASE_URL=D:\databases\nova-gateway.db
LOG_DIR=D:\logs\nova-gateway

# Nova Agent IPC Bridge Connection (WebSocket)
IPC_BRIDGE_URL=ws://localhost:5004
IPC_BRIDGE_SECRET=your_ipc_bridge_secret_here

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Production Webhook Configuration (optional)
# WEBHOOK_DOMAIN=https://your-gateway-subdomain.ngrok-free.app
