{
  "name": "factory-tauri-smoke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4310",
    "build": "node ../../node_modules/vite/bin/vite.js build",
    "package:check": "node scripts/package-check.mjs",
    "package": "pnpm tauri build",
    "test": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibetech/billing": "workspace:*",
    "@tauri-apps/api": "2.11.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^25.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.9"
  }
}
