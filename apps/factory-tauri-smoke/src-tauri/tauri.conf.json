{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FactoryTauriSmoke",
  "version": "0.1.0",
  "identifier": "com.vibetech.factory-tauri-smoke",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://127.0.0.1:4310",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FactoryTauriSmoke",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
