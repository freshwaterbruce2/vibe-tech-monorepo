{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vibetech/*": ["../../packages/*/src", "../../packages/feature-flags/*/src"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/emails"
    },
    {
      "path": "../../packages/billing"
    },
    {
      "path": "../../packages/auth"
    }
  ]
}
