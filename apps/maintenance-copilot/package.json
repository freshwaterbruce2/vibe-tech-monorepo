{
  "name": "@vibetech/maintenance-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "dev:hot": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "gateway": "tsx server/index.ts",
    "build:frontend": "vite build",
    "build:gateway": "node scripts/build-gateway.mjs",
    "build": "tauri build",
    "preview": "vite preview",
    "test": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage --passWithNoTests",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@yao-pkg/pkg": "^6.3.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
