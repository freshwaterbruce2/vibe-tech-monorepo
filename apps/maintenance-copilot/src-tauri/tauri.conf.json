{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monorepo Maintenance Co-Pilot",
  "version": "1.0.0",
  "identifier": "com.vibetech.maintenance.copilot",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:gateway && pnpm build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Vibetech Monorepo Maintenance Co-Pilot", "width": 1280, "height": 800, "resizable": true, "fullscreen": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8675 http://127.0.0.1:8675 ws://localhost:5173;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/gateway"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
