{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "prompt-engineer-app",
  "projectType": "application",
  "root": "apps/prompt-engineer",
  "sourceRoot": "apps/prompt-engineer/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js || npm run dev || echo 'Dev server not configured'",
        "cwd": "apps/prompt-engineer"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build || tsc || npm run build || echo 'Build not configured'",
        "cwd": "apps/prompt-engineer"
      }
    },
    "lint": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "typecheck"
      }
    },
    "quality": {}
  },
  "tags": [
    "type:web",
    "scope:prompt-engineer"
  ]
}
