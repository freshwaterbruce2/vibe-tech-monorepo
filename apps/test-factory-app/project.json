{
  "name": "test-factory-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/test-factory-app/src",
  "projectType": "application",
  "implicitDependencies": [
    "@vibetech/auth",
    "@vibetech/analytics",
    "@vibetech/billing",
    "@vibetech/emails",
    "@vibetech/entitlements",
    "@vibetech/landing"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/test-factory-app"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/test-factory-app"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run preview",
        "cwd": "apps/test-factory-app"
      }
    },
    "api:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev:api",
        "cwd": "apps/test-factory-app"
      }
    },
    "api:build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/server/dist"
      ],
      "options": {
        "command": "pnpm run build:api",
        "cwd": "apps/test-factory-app"
      }
    },
    "api:start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run start:api",
        "cwd": "apps/test-factory-app"
      }
    },
    "ship:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run ship:check",
        "cwd": "apps/test-factory-app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "apps/test-factory-app"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/test-factory-app"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"lint bypassed\"",
        "cwd": "apps/test-factory-app"
      }
    },
    "quality": {},
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "pnpm exec vercel build --prod --yes --scope team_K61A5zl2rIRvueizg7oCGh1n",
          "pnpm exec vercel deploy --prebuilt --prod --scope team_K61A5zl2rIRvueizg7oCGh1n --yes"
        ],
        "cwd": "apps/test-factory-app",
        "parallel": false
      }
    }
  },
  "tags": [
    "scope:web",
    "type:application",
    "factory:generated",
    "factory:saas"
  ]
}