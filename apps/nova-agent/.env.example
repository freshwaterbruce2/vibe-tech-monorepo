# =============================================================================
# NOVA Agent v1.3.0 - Environment Configuration
# Copy this file to .env and fill in your API keys.
# =============================================================================

# ---------------------------------------------------------------------------
# Frontend / Vite Variables (available in browser context)
# ---------------------------------------------------------------------------

# Gravity Claw orchestration server URL
VITE_GRAVITY_CLAW_URL=http://localhost:5187

# Gravity Claw default model
VITE_GRAVITY_CLAW_MODEL=gemini-3.1-pro-preview-customtools

# Feature flags JSON (optional)
# VITE_FEATURE_FLAGS={}

# API Base URLs
VITE_API_URL=http://localhost:9001
VITE_CRYPTO_API_URL=http://localhost:8001

# Moonshot / Kimi API Key (used by frontend moonshot service)
# VITE_KIMI_API_KEY=your_key_here
# VITE_MOONSHOT_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Backend / Rust / Node Variables (NOT available in browser context)
# ---------------------------------------------------------------------------

# Logging
NOVA_LOG_DIR=D:\logs\nova-agent

# Default LLM model
NOVA_DEFAULT_MODEL=kimi-k2.5

# Database & Storage
DATABASE_PATH=D:\databases
TRADING_DB_PATH=D:\databases\trading.db
LEARNING_DB_PATH=D:\databases\agent_learning.db
LANCE_DB_PATH=D:\databases\lancedb
TRADING_DATA_DIR=D:\data\trading
TRADING_LOGS_DIR=D:\logs\trading

# Vector DB
CHROMA_URL=http://localhost:8000

# Workspace
WORKSPACE_ROOT=C:\dev
NOVA_ALLOWED_ROOTS=C:\dev,D:\data

# Review & Artifacts
NOVA_REVIEW_ARTIFACT_DIR=D:\data\nova-reviews

# Feature Toggles
NOVA_ML_BRIDGE_ENABLED=0
NOVA_ENABLE_CODE_EXEC=false
NOVA_ENABLE_ORCHESTRATOR=false
NOVA_SEED_DEMO_DATA=false

# ML Bridge (optional)
# NOVA_ML_BRIDGE_PATH=C:\dev\tools\ml-bridge\bridge.py

# Orchestrator (optional)
# NOVA_ORCHESTRATOR_SCRIPT=C:\dev\scripts\orchestrator.ps1

# Code Execution
# NOVA_PYTHON=python

# Prompts
# NOVA_PROMPT_SEED_DIR=C:\dev\apps\nova-agent\prompts

# DeepCode Integration (optional)
# DEEPCODE_WS_URL=ws://localhost:5004
# DEEPCODE_IPC_ENABLED=false

# ---------------------------------------------------------------------------
# API Keys (Fill these in with your actual keys)
# ---------------------------------------------------------------------------

# DEEPSEEK_API_KEY=your_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# GROQ_API_KEY=your_key_here

# OPENROUTER_API_KEY=your_key_here

# HUGGINGFACE_API_KEY=your_key_here
# HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co

# KIMI_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Mobile Bridge (Localhost-only by default for security)
# ---------------------------------------------------------------------------

# NOVA_MOBILE_LAN_ENABLED=false
NOVA_MOBILE_BRIDGE_PORT=3000
NOVA_MOBILE_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# Mobile Bridge Auth Token (generate a strong random token if enabling LAN)
# MOBILE_BRIDGE_TOKEN=your_secure_random_token

# ---------------------------------------------------------------------------
# Inngest (Background Jobs)
# ---------------------------------------------------------------------------

INNGEST_SERVE_PORT=3100
