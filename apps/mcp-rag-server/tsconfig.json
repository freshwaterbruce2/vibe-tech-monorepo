{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tsup.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../../packages/rag-core"
    }
  ]
}
