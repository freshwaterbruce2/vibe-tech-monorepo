{
  "name": "vibe-justice-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../../node_modules/vite/bin/vite.js",
    "build": "tsc && node ../../../node_modules/vite/bin/vite.js build",
    "build:backend": "pwsh -File build-backend.ps1",
    "preview": "node ../../../node_modules/vite/bin/vite.js preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node ../../../node_modules/vitest/vitest.mjs",
    "test:run": "node ../../../node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ../../../node_modules/vitest/vitest.mjs run --coverage",
    "test:ui": "node ../../../node_modules/vitest/vitest.mjs --ui",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "5.90.21",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vibetech/core": "workspace:*",
    "axios": "1.14.0",
    "clsx": "^2.1.1",
    "immer": "11.1.4",
    "tailwind-merge": "^3.5.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.71.2",
    "react-router": "7.13.1",
    "zod": "catalog:",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "28.1.0",
    "msw": "2.12.10",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.56.1",
    "vite": "catalog:",
    "vitest": "^4.1.9"
  }
}
