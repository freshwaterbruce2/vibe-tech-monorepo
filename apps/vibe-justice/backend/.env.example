##############################
# Vibe-Justice Backend (.env)
##############################

# CRITICAL: API Key for authentication (minimum 32 characters)
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Application will NOT start without this key (fail-closed security)
VIBE_JUSTICE_API_KEY=CHANGE_ME_USE_32_CHAR_MIN_abcdefghijklmnopqrstuvwxyz123456

# Local-only backend mode and canonical application storage.
VIBE_JUSTICE_ENV=production
VIBE_JUSTICE_BIND_HOST=127.0.0.1
VIBE_JUSTICE_DATA_DIR=D:\data\vibe-justice
VIBE_JUSTICE_LOG_DIR=D:\logs\vibe-justice

# Optional full database-file override. If omitted, the database is
# %VIBE_JUSTICE_DATA_DIR%\vibe_justice.sqlite3.
# DATABASE_PATH=D:\data\vibe-justice\vibe_justice.sqlite3

# Optional cloud provider. Local-only startup does not require this value.
# OPENROUTER_API_KEY=sk-or-your-key-here

# CORS Origins (comma-separated)
VIBE_JUSTICE_ALLOWED_ORIGINS=http://127.0.0.1:5175

