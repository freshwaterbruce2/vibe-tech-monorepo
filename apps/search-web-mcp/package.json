{
  "name": "search-web-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Web Search via DuckDuckGo HTML scraping",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
