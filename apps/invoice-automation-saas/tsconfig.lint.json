{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": [
    "src/**/*",
    "server/src/**/*",
    "server/scripts/**/*",
    "scripts/**/*",
    "*.ts"
  ],
  "exclude": ["node_modules", "dist", "server/dist"]
}
