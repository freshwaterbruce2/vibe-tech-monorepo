{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@vibetech/billing": [
        "packages/billing/dist/src/index.d.ts"
      ],
      "@vibetech/email": [
        "packages/email/dist/src/index.d.ts"
      ],
      "@vibetech/emails": [
        "packages/emails/dist/src/index.d.ts"
      ],
      "@vibetech/monetization": [
        "packages/monetization/dist/src/index.d.ts"
      ],
      "@vibetech/payments": [
        "packages/payments/dist/src/index.d.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "extends": "../../../tsconfig.base.json"
}
