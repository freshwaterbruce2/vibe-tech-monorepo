{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/vibe-invoice/Dockerfile",
    "watchPatterns": [
      "apps/vibe-invoice/**",
      "packages/auth/**",
      "packages/billing/**",
      "packages/email/**",
      "packages/emails/**",
      "packages/monetization/**",
      "packages/payments/**",
      "packages/landing/**",
      "packages/ui/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
