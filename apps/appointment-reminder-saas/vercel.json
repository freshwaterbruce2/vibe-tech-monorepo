{
  "buildCommand": "pnpm run build:shared:api && pnpm run build",
  "installCommand": "cd ../.. && pnpm install --force --frozen-lockfile --filter ./apps/appointment-reminder-saas...",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "web": {
      "entrypoint": ".",
      "routePrefix": "/",
      "framework": "vite"
    }
  }
}
