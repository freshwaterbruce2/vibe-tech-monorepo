{
  "name": "vectorshift-svg",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/vectorshift-svg/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run api",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm run build",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run start",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run preview",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "pnpm run lint",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run clean",
        "cwd": "tools/vectorshift-svg"
      }
    },
    "quality": {}
  },
  "tags": ["scope:tooling", "type:tool", "asset-pipeline:svg"]
}
