{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/rag-core",
  "projectType": "library",
  "root": "packages/rag-core",
  "sourceRoot": "packages/rag-core/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc",
        "cwd": "packages/rag-core"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest run",
        "cwd": "packages/rag-core"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage",
        "cwd": "packages/rag-core"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc --noEmit",
        "cwd": "packages/rag-core"
      }
    }
  },
  "tags": [
    "type:library",
    "scope:rag-core"
  ]
}
