{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/avatar-processor",
  "projectType": "library",
  "root": "packages/avatar-processor",
  "sourceRoot": "packages/avatar-processor/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "options": {
        "command": "pnpm build",
        "cwd": "packages/avatar-processor"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint src --ext .ts,.tsx --max-warnings 0",
        "cwd": "packages/avatar-processor"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm typecheck",
        "cwd": "packages/avatar-processor"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "packages/avatar-processor"
      }
    }
  },
  "tags": [
    "type:library",
    "scope:vibetech"
  ]
}
