{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/shared-utils",
  "projectType": "library",
  "root": "packages/shared-utils",
  "sourceRoot": "packages/shared-utils/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
        "cwd": "packages/shared-utils"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings 0",
        "cwd": "packages/shared-utils"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc --noEmit",
        "cwd": "packages/shared-utils"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/shared-utils"
      }
    }
  },
  "tags": [
    "type:library",
    "scope:vibetech"
  ]
}
