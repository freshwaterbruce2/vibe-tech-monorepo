{
  "name": "@vibetech/auth",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared auth helpers for VibeTech workspace apps",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src tests --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.28.2"
  }
}
