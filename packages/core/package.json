{
  "name": "@vibetech/core",
  "version": "1.0.0",
  "description": "Consolidated core services and utilities for the Vibetech monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [
    "vibetech",
    "core",
    "shared",
    "utilities",
    "agents",
    "database",
    "ai"
  ],
  "author": "VibeTech",
  "license": "MIT",
  "dependencies": {
    "@vibetech/logger": "workspace:*",
    "@vibetech/shared-config": "workspace:*",
    "better-sqlite3": "catalog:",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "jsdom": "28.0.0",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
