{
	"name": "@vibetech/feature-flags",
	"version": "0.1.0",
	"private": true,
	"description": "Feature flags system for the monorepo",
	"workspaces": [
		"core",
		"sdk-node",
		"sdk-react",
		"server",
		"dashboard"
	],
	"scripts": {
		"build": "pnpm --filter \"@vibetech/feature-flags-*\" build",
		"dev": "pnpm --filter \"@vibetech/feature-flags-*\" --parallel dev",
		"lint": "pnpm --filter \"@vibetech/feature-flags-*\" lint",
		"test": "pnpm --filter \"@vibetech/feature-flags-*\" test",
		"typecheck": "pnpm --filter \"@vibetech/feature-flags-*\" typecheck"
	}
}
