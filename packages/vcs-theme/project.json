{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/vcs-theme",
  "projectType": "library",
  "root": "packages/vcs-theme",
  "sourceRoot": "packages/vcs-theme/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "tsup src/index.ts --format cjs,esm --dts",
        "cwd": "packages/vcs-theme"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run --passWithNoTests --dir src",
        "cwd": "packages/vcs-theme"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec eslint src --ext .ts --max-warnings 0",
        "cwd": "packages/vcs-theme"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/vcs-theme"
      }
    },
    "quality": {}
  },
  "tags": ["type:library", "scope:vcs"]
}
