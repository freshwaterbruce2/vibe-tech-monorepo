{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/billing",
  "projectType": "library",
  "root": "packages/billing",
  "sourceRoot": "packages/billing/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "options": {
        "command": "tsc",
        "cwd": "packages/billing"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/billing"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint src tests --ext .ts --max-warnings 0",
        "cwd": "packages/billing"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/billing"
      },
      "cache": true
    },
    "quality": {}
  },
  "tags": [
    "type:library",
    "scope:billing"
  ]
}
