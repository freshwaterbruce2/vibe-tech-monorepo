{
  "name": "@vibetech/db-app",
  "version": "1.0.0",
  "description": "App database adapter with migrations and WAL",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrations/runner.js",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [
    "database",
    "sqlite",
    "migrations"
  ],
  "author": "VibeTech",
  "license": "MIT",
  "dependencies": {
    "@vibetech/shared-config": "workspace:*",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "^25.5.0",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
