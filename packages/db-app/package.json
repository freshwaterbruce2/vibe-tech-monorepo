{
  "name": "@vibetech/db-app",
  "version": "1.0.0",
  "description": "App database adapter with migrations and WAL",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrations/runner.js",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [
    "database",
    "sqlite",
    "migrations"
  ],
  "author": "VibeTech",
  "license": "MIT",
  "dependencies": {
    "@vibetech/shared-config": "workspace:*",
    "better-sqlite3": "12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
}
