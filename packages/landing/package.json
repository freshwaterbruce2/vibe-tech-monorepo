{
  "name": "@vibetech/landing",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared landing page sections for VibeTech monetized apps",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
