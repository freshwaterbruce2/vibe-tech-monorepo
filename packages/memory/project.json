{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/memory",
  "projectType": "library",
  "root": "packages/memory",
  "sourceRoot": "packages/memory/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --incremental false",
        "cwd": "packages/memory"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run",
        "cwd": "packages/memory"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint src --ext .ts",
        "cwd": "packages/memory"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc --noEmit",
        "cwd": "packages/memory"
      }
    },
    "quality": {}
  },
  "tags": ["type:library", "scope:memory"]
}
