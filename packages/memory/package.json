{
  "name": "@vibetech/memory",
  "version": "1.0.0",
  "description": "Memory system with episodic, semantic, and procedural stores with vector search",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --incremental false",
    "dev": "tsup --watch",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@vibetech/logger": "workspace:*",
    "better-sqlite3": "catalog:",
    "ollama": "^0.6.3",
    "sqlite-vec": "^0.1.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
