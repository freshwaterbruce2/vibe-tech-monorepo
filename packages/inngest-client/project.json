{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/inngest-client",
  "projectType": "library",
  "root": "packages/inngest-client",
  "sourceRoot": "packages/inngest-client/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
        "cwd": "packages/inngest-client"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest",
        "cwd": "packages/inngest-client"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint . --max-warnings 0",
        "cwd": "packages/inngest-client"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc --noEmit",
        "cwd": "packages/inngest-client"
      }
    },
    "quality": {}
  },
  "tags": ["type:library", "scope:inngest"]
}
