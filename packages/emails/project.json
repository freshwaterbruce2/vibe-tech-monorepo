{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vibetech/emails",
  "projectType": "library",
  "root": "packages/emails",
  "sourceRoot": "packages/emails/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "options": {
        "command": "tsc -p tsconfig.json --incremental false",
        "cwd": "packages/emails"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/emails"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint src tests --ext .ts,.tsx --max-warnings 0",
        "cwd": "packages/emails"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/emails"
      },
      "cache": true
    },
    "quality": {}
  },
  "tags": [
    "type:library",
    "scope:emails"
  ]
}
