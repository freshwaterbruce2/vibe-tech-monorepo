{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx.cmd",
        "-y",
        "nx-mcp@0.25.0",
        "V:/monorepo",
        "--transport",
        "stdio",
        "--disableTelemetry",
        "--no-minimal"
      ],
      "env": {
        "NX_WORKSPACE_ROOT": "V:/monorepo",
        "NODE_OPTIONS": "--require V:/monorepo/scripts/nx-mcp-native-compat.cjs"
      }
    },
    "desktop-commander": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/desktop-commander-v3/dist/mcp.js"],
      "env": {
        "NODE_ENV": "production"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx.cmd",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "V:/monorepo",
        "D:/databases",
        "D:/logs",
        "D:/learning-system",
        "D:/data"
      ]
    },
    "sqlite": {
      "type": "stdio",
      "command": "C:/Users/fresh_zxae3v6/.local/bin/uvx.exe",
      "args": ["mcp-server-sqlite", "--db-path", "D:/databases/database.db"]
    },
    "skills": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/mcp-skills-server/dist/index.js"]
    },
    "memory": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/memory-mcp/dist/index.js"],
      "alwaysLoad": true,
      "env": {
        "MEMORY_DB_PATH": "D:/databases/memory.db",
        "MEMORY_EMBEDDING_MODEL": "text-embedding-3-small",
        "MEMORY_EMBEDDING_DIM": "1536",
        "MEMORY_EMBEDDING_ENDPOINT": "http://localhost:3001",
        "LEARNING_DB_PATH": "D:/databases/agent_learning.db"
      }
    },
    "youtube": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@anaisbetts/mcp-youtube"]
    },
    "notebooklm": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "notebooklm_mcp_server"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "rag": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/mcp-rag-server/dist/index.js"],
      "env": {
        "NODE_ENV": "production"
      }
    },
    "workspace": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/workspace-mcp-server/dist/index.js"],
      "env": {
        "WORKSPACE_ROOT": "V:/monorepo"
      }
    },
    "learning-pipeline": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/learning-pipeline-mcp/dist/index.js"],
      "env": {
        "WORKSPACE_ROOT": "V:/monorepo"
      }
    },
    "skill-feedback": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/skill-feedback-mcp/dist/index.js"],
      "env": {
        "LEARNING_DB_PATH": "D:/databases/agent_learning.db"
      }
    },
    "proactive-recommendations": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/proactive-recommendations-mcp/dist/index.js"],
      "env": {
        "WORKSPACE_ROOT": "V:/monorepo",
        "LEARNING_DB_PATH": "D:/databases/agent_learning.db"
      }
    },
    "monorepo-health": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/monorepo-health-mcp/dist/index.js"],
      "env": {
        "WORKSPACE_ROOT": "V:/monorepo"
      }
    },
    "command-center": {
      "type": "stdio",
      "command": "node.exe",
      "args": ["V:/monorepo/apps/vibetech-command-center/dist/mcp/server.js"],
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}
