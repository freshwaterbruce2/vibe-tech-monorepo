{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx.cmd",
        "-y",
        "nx-mcp@0.25.0",
        "V:/monorepo",
        "--transport",
        "stdio",
        "--disableTelemetry",
        "--no-minimal"
      ],
      "env": {
        "NX_WORKSPACE_ROOT": "V:/monorepo",
        "NODE_OPTIONS": "--require V:/monorepo/scripts/nx-mcp-native-compat.cjs"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx.cmd",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "V:/monorepo",
        "D:/databases",
        "D:/logs",
        "D:/learning-system",
        "D:/data"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "node",
      "args": ["V:/monorepo/apps/memory-mcp/dist/index.js"],
      "env": {
        "MEMORY_DB_PATH": "D:/databases/memory.db",
        "LEARNING_DB_PATH": "D:/databases/agent_learning.db"
      }
    }
  }
}
