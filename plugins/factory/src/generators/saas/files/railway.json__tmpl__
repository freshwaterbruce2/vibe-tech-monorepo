{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/<%= projectName %>/Dockerfile",
    "watchPatterns": [
      "apps/<%= projectName %>/**",
      "packages/auth/**",
      "packages/analytics/**",
      "packages/billing/**",
      "packages/emails/**",
      "packages/entitlements/**",
      "packages/feature-flags/core/**",
      "packages/landing/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
