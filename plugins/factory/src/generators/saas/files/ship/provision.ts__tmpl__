import { execSync } from 'node:child_process';
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { loadConfig, saveConfig, isProvisioned } from './config.js';
import type { ShipConfig } from './config.js';
import { loadLocalEnv } from '../server/src/loadLocalEnv.js';

// Resolve project root relative to this file so the script works regardless of
// where the user invokes it from.
const here = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.resolve(here, '..', '..');

// Env keys that both Vercel and Railway need so the deployed app boots without
// missing-configuration crashes. Sourced from the local .env the generator wrote.
const REQUIRED_ENV_KEYS = [
  'PORT',
  'HOST',
  'APP_BASE_URL',
  'AUTH_SECRET',
  'STRIPE_SECRET_KEY',
  'VITE_STRIPE_PUBLIC_KEY',
  'VITE_API_BASE_URL',
  'OPENROUTER_API_KEY',
  'RESEND_API_KEY',
  'EMAIL_FROM',
] as const;

interface StepResult {
  name: string;
  ok: boolean;
  detail: string;
}

const results: StepResult[] = [];

loadLocalEnv(projectRoot);

async function main(): Promise<void> {
  const config = await loadConfig();

  if (isProvisioned(config)) {
    console.log('[provision] Already provisioned:');
    console.log(`  vercel projectId: ${config.vercel.projectId}`);
    console.log(`  railway projectId: ${config.railway.projectId}`);
    console.log(`  stripe webhookId: ${config.stripe.webhookId}`);
    console.log('[provision] Re-running steps to reconcile any drift.');
  }

  await ensureCli('gh', 'npm install -g @github/gh-cli');
  await ensureCli('vercel', 'npm install -g vercel');
  await ensureCli('railway', 'npm install -g @railway/cli');

  await provisionGit(config);
  await provisionVercel(config);
  await provisionRailway(config);
  await provisionStripe(config);

  await saveConfig(config);
  printSummary();
}

// Fail fast with actionable install instructions rather than a confusing
// downstream stack trace from execSync when a CLI is absent.
async function ensureCli(name: string, installHint: string): Promise<void> {
  try {
    execSync(`which ${name}`, { stdio: 'ignore' });
  } catch {
    console.error(`[provision] Required CLI "${name}" is not installed.`);
    console.error(`[provision] Install it with: ${installHint}`);
    process.exit(1);
  }
}

async function provisionGit(config: ShipConfig): Promise<void> {
  const branch = `feat/<%= projectName %>`;
  console.log(`[git] Preparing branch ${branch}`);
  try {
    try {
      execSync(`git rev-parse --verify ${branch}`, { cwd: projectRoot, stdio: 'ignore' });
    } catch {
      execSync(`git checkout -b ${branch}`, { cwd: projectRoot, stdio: 'inherit' });
    }
    execSync('git add -A', { cwd: projectRoot, stdio: 'inherit' });

    try {
      execSync('git commit -m "feat: scaffold <%= displayName %>"', {
        cwd: projectRoot,
        stdio: 'inherit',
      });
      config.git.committed = true;
    } catch {
      // Nothing to commit; keep committed state as-is.
      console.log('[git] No changes to commit.');
    }

    execSync(`git push -u origin ${branch}`, { cwd: projectRoot, stdio: 'inherit' });

    const prUrl = execSync(
      'gh pr create --title "feat: scaffold <%= displayName %>" --body "Generated by @vibetech/factory:saas"',
      { cwd: projectRoot, encoding: 'utf8' },
    ).trim();

    config.git.branch = branch;
    config.git.prUrl = prUrl || null;
    results.push({ name: 'git', ok: true, detail: `PR: ${prUrl}` });
  } catch (error) {
    results.push({ name: 'git', ok: false, detail: formatError(error) });
  }
}

async function provisionVercel(config: ShipConfig): Promise<void> {
  console.log('[vercel] Provisioning project');
  try {
    try {
      execSync(`vercel project add <%= projectName %>`, {
        cwd: projectRoot,
        stdio: 'pipe',
      });
    } catch {
      // Project may already exist from a previous run; link instead of failing.
      console.log('[vercel] Project may already exist, continuing to link.');
    }

    execSync('vercel link --yes', { cwd: projectRoot, stdio: 'inherit' });

    const envValues = await readEnvValues(REQUIRED_ENV_KEYS);
    for (const [key, value] of Object.entries(envValues)) {
      if (!value) {
        console.log(`[vercel] Skipping ${key}: not set in .env`);
        continue;
      }
      // Pipe via stdin so secret values do not leak into shell history or logs.
      execSync(`vercel env add ${key} production`, {
        cwd: projectRoot,
        input: `${value}\n`,
        stdio: ['pipe', 'ignore', 'ignore'],
      });
    }

    // After linking, Vercel writes .vercel/project.json which is the most
    // reliable source for projectId/orgId across CLI versions.
    const projectMeta = JSON.parse(
      await readFile(path.join(projectRoot, '.vercel', 'project.json'), 'utf8'),
    ) as { projectId?: string; orgId?: string };

    config.vercel.projectId = projectMeta.projectId ?? null;
    config.vercel.orgId = projectMeta.orgId ?? null;
    results.push({
      name: 'vercel',
      ok: Boolean(config.vercel.projectId),
      detail: `projectId: ${config.vercel.projectId ?? 'unknown'}`,
    });
  } catch (error) {
    results.push({ name: 'vercel', ok: false, detail: formatError(error) });
  }
}

async function provisionRailway(config: ShipConfig): Promise<void> {
  console.log('[railway] Provisioning project');
  try {
    try {
      execSync(`railway init --name <%= projectName %>`, {
        cwd: projectRoot,
        stdio: 'pipe',
      });
    } catch {
      console.log('[railway] Project may already exist, continuing to link.');
    }

    execSync('railway link', { cwd: projectRoot, stdio: 'inherit' });

    try {
      execSync('railway volume add --mount-path /data', {
        cwd: projectRoot,
        stdio: 'inherit',
      });
    } catch {
      // Volume may already exist; non-fatal.
      console.log('[railway] Volume may already exist, continuing.');
    }

    const envValues = await readEnvValues(REQUIRED_ENV_KEYS);
    for (const [key, value] of Object.entries(envValues)) {
      if (!value) {
        console.log(`[railway] Skipping ${key}: not set in .env`);
        continue;
      }
      execSync(`railway variable set ${key}=${value}`, {
        cwd: projectRoot,
        stdio: 'ignore',
      });
    }

    // status --json gives the authoritative project/service ids in a stable shape.
    const statusRaw = execSync('railway status --json', {
      cwd: projectRoot,
      encoding: 'utf8',
    }).trim();
    const status = JSON.parse(statusRaw) as {
      project?: { id?: string };
      service?: { id?: string };
    };

    config.railway.projectId = status.project?.id ?? null;
    config.railway.serviceId = status.service?.id ?? null;
    results.push({
      name: 'railway',
      ok: Boolean(config.railway.projectId),
      detail: `projectId: ${config.railway.projectId ?? 'unknown'}`,
    });
  } catch (error) {
    results.push({ name: 'railway', ok: false, detail: formatError(error) });
  }
}

async function provisionStripe(config: ShipConfig): Promise<void> {
  console.log('[stripe] Provisioning webhook endpoint');
  const stripeKey = process.env.STRIPE_SECRET_KEY;
  if (!stripeKey) {
    results.push({
      name: 'stripe',
      ok: false,
      detail: 'STRIPE_SECRET_KEY not set; skipping webhook provisioning',
    });
    return;
  }

  // Railway is the backend host, so the webhook must point there.
  const railwayUrl = config.railway.url ?? '';
  if (!railwayUrl) {
    // Try to resolve a live Railway domain from status before creating the webhook.
    try {
      const statusRaw = execSync('railway status --json', {
        cwd: projectRoot,
        encoding: 'utf8',
      }).trim();
      const status = JSON.parse(statusRaw) as { service?: { domains?: string[] } };
      config.railway.url = status.service?.domains?.[0] ?? null;
    } catch {
      // Leave null; we cannot create the webhook without a public backend URL.
    }
  }

  const backendBase = config.railway.url;
  if (!backendBase) {
    results.push({
      name: 'stripe',
      ok: false,
      detail: 'Railway backend URL not available; deploy first or set manually',
    });
    return;
  }

  try {
    const response = await fetch('https://api.stripe.com/v1/webhook_endpoints', {
      method: 'POST',
      headers: {
        Authorization: *** ${stripeKey}`,
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams([
        ['url', `${backendBase}/api/webhooks/stripe`],
        ['enabled_events[]', 'checkout.session.completed'],
        ['enabled_events[]', 'customer.subscription.created'],
        ['enabled_events[]', 'customer.subscription.updated'],
        ['enabled_events[]', 'customer.subscription.deleted'],
      ]),
    });

    if (!response.ok) {
      const body = await response.text();
      results.push({
        name: 'stripe',
        ok: false,
        detail: `Stripe API returned ${response.status}: ${body}`,
      });
      return;
    }

    const webhook = (await response.json()) as {
      id: string;
      secret: string;
    };

    config.stripe.webhookId = webhook.id;
    config.stripe.webhookSecret = webhook.secret;

    // Push the signing secret to both platforms so webhook signature verification
    // works in production without a second manual step.
    await pushEnvToVercel('STRIPE_WEBHOOK_SECRET', webhook.secret);
    await pushEnvToRailway('STRIPE_WEBHOOK_SECRET', webhook.secret);

    results.push({
      name: 'stripe',
      ok: true,
      detail: `webhookId: ${webhook.id}`,
    });
  } catch (error) {
    results.push({ name: 'stripe', ok: false, detail: formatError(error) });
  }
}

async function pushEnvToVercel(key: string, value: string): Promise<void> {
  try {
    execSync(`vercel env add ${key} production`, {
      cwd: projectRoot,
      input: `${value}\n`,
      stdio: ['pipe', 'ignore', 'ignore'],
    });
  } catch (error) {
    console.log(`[vercel] Failed to push ${key}: ${formatError(error)}`);
  }
}

async function pushEnvToRailway(key: string, value: string): Promise<void> {
  try {
    execSync(`railway variable set ${key}=${value}`, {
      cwd: projectRoot,
      stdio: 'ignore',
    });
  } catch (error) {
    console.log(`[railway] Failed to push ${key}: ${formatError(error)}`);
  }
}

// Read selected keys from .env so we can push them to both platforms without
// requiring the user to re-enter secrets they already configured locally.
async function readEnvValues(
  keys: readonly string[],
): Promise<Record<string, string>> {
  const values: Record<string, string> = {};
  try {
    const raw = await readFile(path.join(projectRoot, '.env'), 'utf8');
    for (const line of raw.split(/\r?\n/)) {
      const separator = line.indexOf('=');
      if (separator <= 0) continue;
      const key = line.slice(0, separator).trim();
      if (!keys.includes(key as (typeof keys)[number])) continue;
      const value = line
        .slice(separator + 1)
        .trim()
        .replace(/^["']|["']$/g, '');
      if (value) values[key] = value;
    }
  } catch {
    // .env may not exist yet; return empty values.
  }
  // Fall back to process.env for keys loaded by loadLocalEnv but not in .env.
  for (const key of keys) {
    if (!values[key] && process.env[key]) {
      values[key] = process.env[key] as string;
    }
  }
  return values;
}

function printSummary(): void {
  console.log('\n[provision] Summary:');
  for (const result of results) {
    const label = result.ok ? 'PASS' : 'FAIL';
    console.log(`  ${label} ${result.name}: ${result.detail}`);
  }
}

function formatError(error: unknown): string {
  if (error instanceof Error) {
    return error.message;
  }
  return String(error);
}

await main();