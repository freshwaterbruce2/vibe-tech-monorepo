{
  "buildCommand": "pnpm run build:shared:api && pnpm run build",
  "installCommand": "cd ../.. && pnpm install --force --frozen-lockfile --filter ./apps/<%= projectName %>...",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
