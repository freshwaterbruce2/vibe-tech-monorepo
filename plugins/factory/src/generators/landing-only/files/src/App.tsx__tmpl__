import { LandingPage, createDefaultLandingContent } from '@vibetech/landing';

const content = createDefaultLandingContent({
  productName: '<%= displayName %>',
  badge: 'Generated by @vibetech/factory:landing-only',
  title: '<%= displayName %>',
  subtitle:
    'Launch-ready landing surface for a VibeTech product. Replace this copy with the real product offer and connect the primary action to signup.',
  previewItems: ['Hero section', 'Feature grid', 'Pricing tiers', 'FAQ section'],
  featuresHeading: 'Default sections already in place',
  featuresSubheading:
    'Start from the shared landing package, then replace the content instead of rebuilding the whole page.',
  ctaHeading: 'Turn the first visitor into the first account',
  ctaBody:
    'This generator gives the app a conversion-ready landing page before feature-specific frontend work begins.',
  footerRight: 'Built with the VibeTech factory landing generator',
});

export function App() {
  return <LandingPage content={content} />;
}
