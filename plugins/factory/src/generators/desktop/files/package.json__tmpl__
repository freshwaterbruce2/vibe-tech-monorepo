{
  "name": "<%= projectName %>",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1 --port <%= port %>",
    "build": "node ../../node_modules/vite/bin/vite.js build",
    "package:check": "node scripts/package-check.mjs",
    "package": "pnpm tauri build",
    "test": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibetech/billing": "workspace:*",
    "@tauri-apps/api": "2.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
