import { StyleSheet, Text, View } from 'react-native';
import { ThemeButton } from '../components/ThemeButton';
import { config } from '../config';

/* eslint-disable-next-line @typescript-eslint/no-explicit-any */
export function HomeScreen({ navigation }: any) {
  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.title}><%= displayName %></Text>
        <Text style={styles.subtitle}>Expo 54 + React Native 0.81 Scaffold</Text>
      </View>

      <View style={styles.card}>
        <Text style={styles.cardTitle}>Vibe-Tech Design Tokens</Text>
        <View style={styles.row}>
          <View style={[styles.badge, { backgroundColor: config.THEME.ACCENT_CYAN }]}><Text style={styles.badgeText}>Cyan</Text></View>
          <View style={[styles.badge, { backgroundColor: config.THEME.ACCENT_MAGENTA }]}><Text style={styles.badgeText}>Magenta</Text></View>
          <View style={[styles.badge, { backgroundColor: config.THEME.ACCENT_GREEN }]}><Text style={styles.badgeText}>Green</Text></View>
        </View>
        <Text style={styles.description}>
          This template is pre-configured with native workspace resolution, tsconfig base setups, haptics, biometrics, and vitest.
        </Text>
      </View>

      <View style={styles.actions}>
        <ThemeButton
          title="Go to Settings"
          variant="accent"
          hapticType="light"
          onPress={() => navigation.navigate('Settings')}
        />
        <ThemeButton
          title="Trigger Success Haptic"
          variant="primary"
          hapticType="success"
        />
        <ThemeButton
          title="Trigger Warning Haptic"
          variant="secondary"
          hapticType="warning"
        />
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
