  },
  subtitle: {
    color: config.THEME.TEXT_SECONDARY,
    fontSize: 14,
    marginTop: 8,
  },
  card: {
    backgroundColor: config.THEME.SURFACE,
    borderRadius: 12,
    padding: 20,
    borderWidth: 1,
    borderColor: config.THEME.BORDER,
    marginBottom: 32,
