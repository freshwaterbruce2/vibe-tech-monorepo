shamefully-hoist=true
node-linker=hoisted
# Linking strategy. The store MUST be on the same volume as the code (store-dir below),
# or every install falls back to a full file copy. V:\ is a ReFS Dev Drive; we use
# hardlink = O(1) same-volume hard-links (just as fast as clone, but reliable).
# NOT clone: pnpm's reflink/CoW path repeatedly hangs/corrupts on ReFS Dev Drives
# (pnpm#7186, #7554) with no fallback — a wedged reflink silently freezes the link phase.
# Managed by scripts/configure-pnpm-store.ps1 (ReFS->hardlink, NTFS->auto, else copy).
package-import-method=hardlink
public-hoist-pattern[]=*rollup*
public-hoist-pattern[]=@rollup/*
engine-strict=true
# Store location: on V:\ (same ReFS volume as the code) but OUTSIDE the repo so its
# 200k+ files don't slow git/ripgrep/nx. Set by scripts/configure-pnpm-store.ps1.
store-dir=V:\pnpm-store
# Keep the hoisted linker until the React Native/Capacitor/Electron projects are
# revalidated with pnpm's default isolated linker.
minimum-release-age=1440
minimum-release-age-exclude[]=@vibetech/*
minimum-release-age-exclude[]=@nova/*
trust-policy=no-downgrade
trust-policy-ignore-after=10080
