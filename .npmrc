shamefully-hoist=true
node-linker=hoisted
# Cross-drive linking strategy.
# PNPM hard links cannot span NTFS volumes. If V:\ (code) and D:\ (store) are
# both ReFS/Dev Drive, use package-import-method=clone for O(1) CoW reflinks.
# Run scripts/configure-pnpm-store.ps1 to auto-detect and apply the right value.
package-import-method=copy
public-hoist-pattern[]=*rollup*
public-hoist-pattern[]=@rollup/*
engine-strict=true
# Default store location. This is moved to V:\monorepo\.pnpm-store-v2 by
# scripts/configure-pnpm-store.ps1 when either volume is NTFS.
store-dir=D:\pnpm-store-v2
# Keep the hoisted linker until the React Native/Capacitor/Electron projects are
# revalidated with pnpm's default isolated linker.
minimum-release-age=1440
minimum-release-age-exclude[]=@vibetech/*
minimum-release-age-exclude[]=@nova/*
trust-policy=no-downgrade
trust-policy-ignore-after=10080
